# HyFib W360 environment configuration.
# Copy to .env for local development. NEVER commit real values. In staging/production every secret
# comes from the secret manager and is injected as an environment variable at runtime.

# --- Runtime -------------------------------------------------------------------------------------
# NODE_ENV is set by the tooling (next dev/build/start, test runners); do not set it here.
# local | test | staging | production (production refuses local/test)
APP_ENV=local
LOG_LEVEL=info
# public origin; must be https in production
APP_BASE_URL=http://localhost:3000
# Extra exact origins allowed to call server actions/auth (comma-separated), e.g. a preview domain.
TRUSTED_ORIGINS=
# Load balancer IPs/CIDRs so client IPs are read correctly from X-Forwarded-For (rate limits, audit).
TRUSTED_PROXIES=

# --- Database (see infra/db/bootstrap-roles.sql) ------------------------------------------------
# Runtime role: no ownership, no BYPASSRLS. Used by web and worker for tenant data.
DATABASE_URL_APP=postgres://w360_app:CHANGE_ME@127.0.0.1:54329/w360
# Identity tables only (authentication library).
DATABASE_URL_AUTH=postgres://w360_auth:CHANGE_ME@127.0.0.1:54329/w360
# Platform administration role (explicit cross-company policies only).
DATABASE_URL_PLATFORM=postgres://w360_platform:CHANGE_ME@127.0.0.1:54329/w360
# Owner/migration role. Only the migrate command uses this; do not give it to web or worker.
DATABASE_URL_MIGRATE=postgres://w360_owner:CHANGE_ME@127.0.0.1:54329/w360
DATABASE_POOL_MAX_APP=10
DATABASE_POOL_MAX_AUTH=5
DATABASE_POOL_MAX_PLATFORM=2
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Secrets -----------------------------------------------------------------------------------
# AES-256-GCM keys for secrets at rest: "kid:base64(32 bytes)" comma-separated. New writes use the
# primary key; keep old keys until the re-encryption job has rotated all ciphertexts.
#   node -e "console.log('k2026a:'+require('crypto').randomBytes(32).toString('base64'))"
W360_ENCRYPTION_KEYS=
W360_ENCRYPTION_PRIMARY_KEY_ID=k2026a
# HMAC key for signed job envelopes (>= 32 chars).
W360_JOB_SIGNING_KEY=
# Rotating it, one rotation at a time (RUNBOOKS section 13, ADR-135): first add the new key as NEXT
# (accepted, signs nothing); then make it the key above with the old one as PREVIOUS (accepted
# while the worker signs queued jobs again); remove PREVIOUS once Operations -> Keys shows no job
# signed with it. Never both at once.
W360_JOB_SIGNING_KEY_NEXT=
W360_JOB_SIGNING_KEY_PREVIOUS=
# Authentication library secret (>= 32 chars). Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Stable Server Actions encryption key shared by all web replicas (base64 of 32 bytes).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Hours a privileged member may work before two-factor enrolment becomes mandatory.
MFA_GRACE_PERIOD_HOURS=72
INVITATION_TTL_HOURS=168
# Screening the passwords people set against breached ones (ADR-317): pwned-passwords or off. Unset,
# on for APP_ENV=staging|production (the web tier then reaches https://api.pwnedpasswords.com) and
# off for local|test.
PASSWORD_BREACH_CHECK=
# Only for APP_ENV=local|test (points the check at a local stand-in); staging and production always
# use https://api.pwnedpasswords.com.
PWNED_PASSWORDS_BASE_URL=

# --- Transactional email (one provider through SMTP) ------------------------------------------
# Local development uses Mailpit (docker compose); UI at http://localhost:8025.
EMAIL_FROM=no-reply@localhost
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Meta WhatsApp Business Platform (optional until onboarding is configured) ----------------
# Leave empty to keep WhatsApp features reported as unavailable. See docs/META-SETUP.md.
META_APP_ID=
# App secret: verifies webhook signatures (X-Hub-Signature-256) and exchanges signup codes.
META_APP_SECRET=
# During an app-secret rotation, set the old secret here until Meta signs with the new one.
META_APP_SECRET_PREVIOUS=
META_GRAPH_API_VERSION=v26.0
# Random string you also enter in the Meta app's webhook settings (GET verification handshake).
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business configuration id used by Embedded Signup.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Only for APP_ENV=local|test (points the Graph client at a local stand-in); staging and production
# always use https://graph.facebook.com.
META_GRAPH_BASE_URL=

# --- Razorpay (optional until the merchant account is activated) ------------------------------
# rzp_test_… for test mode; rzp_live_… is accepted only with APP_ENV=production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Previous webhook secret, accepted while a rotation is in progress (see docs/DEPLOYMENT.md).
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Local/test only: point the API client at the test-only stand-in (refused in staging/production).
RAZORPAY_API_BASE_URL=
# Only set true after Razorpay confirms Recurring Payments (card mandates) are enabled.
RAZORPAY_RECURRING_CARDS_ENABLED=false
# Paying for plans (ADR-063): only set true after Razorpay activates Subscriptions and Flash Checkout
# for the account and the tax on plan prices has been reviewed.
RAZORPAY_SUBSCRIPTIONS_ENABLED=false

# --- Shopify (optional: lets companies connect their Shopify stores) ---------------------------
# HyFib's own Shopify app (Dev Dashboard → app → Settings); see docs/DEPLOYMENT.md "Shopify app".
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Previous client secret, accepted for signatures while a rotation is in progress.
SHOPIFY_CLIENT_SECRET_PREVIOUS=
# The Admin API version the connector speaks (its queries were checked against this version).
SHOPIFY_API_VERSION=2026-07
# Local/test only: sends every shop to <base>/<shop> (the test-only stand-in); refused elsewhere.
SHOPIFY_TEST_BASE_URL=

# --- Private object storage (S3 compatible) ----------------------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Worker ----------------------------------------------------------------------------------
WORKER_HEALTH_PORT=9464
WORKER_CONCURRENCY=4

# --- Automation web requests -----------------------------------------------------------------
# Local/test only: lets HTTP steps call http:// and loopback targets (a local test server).
# Web and worker refuse to start with it outside APP_ENV=local|test. Leave unset in production.
W360_EGRESS_ALLOW_LOOPBACK=

# --- Telemetry ----------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
